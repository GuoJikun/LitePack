{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitePack",
  "version": "0.1.0",
  "identifier": "com.litepack.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerHooks": "hooks.nsh"
      },
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": ["wix/context-menu.wxs"],
        "componentRefs": ["ContextMenuRegistry"]
      }
    }
  }
}
