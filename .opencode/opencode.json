{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "external_directory": {
      "~/.cargo/**": "allow",
      "~/.rustup/**": "allow"
    },
    "edit": {
      "~/.cargo/**": "deny",
      "~/.rustup/**": "deny"
    },
    "bash": {
      "cargo *": "ask"
    }
  }
}